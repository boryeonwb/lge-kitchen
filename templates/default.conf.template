# 광고주 공유용 대시보드 — 정적 파일 + /api 프록시.
#
# 이 앱에는 백엔드가 없다. 숫자는 lge-billing-dashboard 백엔드의 /api/adv/* 에서 온다.
# ${API_UPSTREAM} 은 컨테이너 시작 시 envsubst 로 채워진다(Dockerfile 의 ENV 가 기본값).
# nginx 는 변수 없는 proxy_pass 의 호스트를 기동 시 한 번 해석하므로, 업스트림 Service 가
# 없으면 기동에 실패한다 — 주소가 틀렸다는 걸 조용히 500 으로 숨기지 않는다.
server {
    listen 3000;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 운영 탭은 미디어믹스 시트·SMBS 환율을 다시 받을 수 있어 느릴 때가 있다
        proxy_read_timeout 120s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }
}
